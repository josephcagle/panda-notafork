synonym: "8-oxo-dGTP pyrophosphohydrolase activity" EXACT [PMID:17804481]
synonym: "8-oxo-dGTPase activity" EXACT [PMID:7782328]
xref: EC:3.6.1.55
xref: Reactome:R-HSA-2395849 "NUDT1 hydrolyses 8-oxo-dGTP to 8-oxo-dGMP"
